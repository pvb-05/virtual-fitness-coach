# Cấu hình môi trường cho Virtual Fitness Coach
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# Google Gemini API Key (Lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình Database
DATABASE_PATH=database/fitness_coach.db

# Cấu hình Thư mục Audio TTS Cache
TTS_CACHE_DIR=static/audios
